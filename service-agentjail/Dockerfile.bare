# ── Bare runner image — no nsjail, no special capabilities ──────────────────
# Use this for Kubernetes environments that deny SYS_ADMIN / SYS_CHROOT.
# ⚠️  Provides NO sandbox isolation — commands run as the service user.

# ── Stage 1: Build agentjail Python package ─────────────────────────────────
FROM ubuntu:24.04 AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV UV_PYTHON_INSTALL_DIR=/opt/agentjail/python

WORKDIR /opt/agentjail
COPY pyproject.toml .
COPY src/ src/
COPY config/ config/

RUN uv sync --no-dev --no-editable --python 3.14

# ── Stage 2: Runtime ────────────────────────────────────────────────────────
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/agentjail /opt/agentjail

# Create non-root service user
RUN groupadd --system service-group \
    && useradd --system --gid service-group --create-home --shell /bin/bash service

# Prepare state directories
RUN mkdir -p /var/lib/agentjail/sandboxes /var/lib/agentjail/meta \
    && chown -R service:service-group /var/lib/agentjail

USER service

ENV AGENTJAIL_RUNNER=bare

EXPOSE 8000

ENTRYPOINT ["/opt/agentjail/.venv/bin/agentjail"]
CMD ["--host", "0.0.0.0", "--port", "8000"]
